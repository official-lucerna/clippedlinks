<!DOCTYPE html>
<html lang="en" data-theme="dark">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Search — <%= currentBookmark.name %> - ClippedLinks</title>
    <meta name="description"
        content="Save your favorite links elegantly without compromise. Open-Source premium bookmark manager for the modern web.">
    <link rel="icon" type="image/png" href="./assets/img/logo.png">

    <link rel="stylesheet" href="/assets/css/style.css">
    <script src="https://unpkg.com/lucide@latest"></script>

    <style>
        .se-wrapper {
            display: grid;
            grid-template-columns: 1fr 280px;
            gap: 24px;
            padding: 96px 3% 48px;
            min-height: 100vh;
            box-sizing: border-box;
            align-items: flex-start;
        }

        .se-hero {
            margin-bottom: 28px;
        }

        .se-breadcrumb {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 20px;
            font-size: 0.82rem;
            color: var(--text-muted);
        }

        .se-breadcrumb a {
            color: var(--text-muted);
            text-decoration: none;
            transition: color 0.2s;
        }

        .se-breadcrumb a:hover { color: var(--accent-color); }

        .se-title {
            font-size: 1.6rem;
            font-weight: 800;
            letter-spacing: -0.5px;
            margin-bottom: 4px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .se-title-icon {
            width: 36px;
            height: 36px;
            background: linear-gradient(135deg, var(--accent-color), #60a5fa);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .se-subtitle {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-bottom: 20px;
        }

        .se-input-wrap {
            position: relative;
            display: flex;
            align-items: center;
        }

        .se-search-icon {
            position: absolute;
            left: 16px;
            color: var(--text-muted);
            pointer-events: none;
            transition: color 0.2s;
        }

        .se-clear-btn {
            position: absolute;
            right: 14px;
            background: none;
            border: none;
            color: var(--text-muted);
            cursor: pointer;
            padding: 4px;
            border-radius: 6px;
            display: none;
            align-items: center;
            transition: color 0.2s;
        }

        .se-clear-btn:hover { color: var(--text-color); }
        .se-clear-btn.visible { display: flex; }

        #seInput {
            width: 100%;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--border-color);
            border-radius: 14px;
            padding: 15px 48px 15px 50px;
            font-size: 1rem;
            color: var(--text-color);
            outline: none;
            transition: all 0.25s ease;
            backdrop-filter: blur(8px);
        }

        [data-theme="light"] #seInput {
            background: rgba(0, 0, 0, 0.03);
        }

        #seInput:focus {
            border-color: var(--accent-color);
            box-shadow: 0 0 0 3px var(--accent-glow), 0 8px 24px rgba(0,0,0,0.2);
            background: transparent;
        }

        #seInput:focus ~ .se-search-icon,
        .se-input-wrap:focus-within .se-search-icon {
            color: var(--accent-color);
        }

        .se-stats {
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 16px 0 20px;
            font-size: 0.82rem;
            color: var(--text-muted);
        }

        .se-stats-pill {
            background: rgba(255,255,255,0.05);
            border: 1px solid var(--border-color);
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 0.78rem;
            font-weight: 600;
            color: var(--accent-color);
        }


        #seResults {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .se-result-card {
            background: rgba(255,255,255,0.03);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 14px 18px;
            display: flex;
            align-items: flex-start;
            gap: 14px;
            transition: border-color 0.2s, box-shadow 0.2s, transform 0.15s;
            text-decoration: none;
            color: inherit;
            animation: fadeIn 0.3s ease-out both;
        }

        .se-result-card:hover {
            border-color: var(--accent-color);
            box-shadow: 0 4px 20px rgba(59,130,246,0.12);
            transform: translateY(-1px);
        }

        .se-favicon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: rgba(255,255,255,0.06);
            border: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            overflow: hidden;
            font-size: 13px;
            color: var(--text-muted);
        }

        .se-favicon img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        .se-card-body {
            flex: 1;
            min-width: 0;
        }

        .se-card-name {
            font-size: 0.95rem;
            font-weight: 600;
            color: var(--text-color);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin-bottom: 2px;
        }

        .se-card-name mark {
            background: rgba(59,130,246,0.25);
            color: var(--accent-color);
            border-radius: 3px;
            padding: 0 2px;
        }

        .se-card-url {
            font-size: 0.78rem;
            color: var(--text-muted);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin-bottom: 5px;
        }

        .se-card-desc {
            font-size: 0.82rem;
            color: var(--text-muted);
            display: -webkit-box;
            -webkit-line-clamp: 2;
            line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            line-height: 1.4;
        }

        .se-card-desc mark {
            background: rgba(59,130,246,0.2);
            color: var(--accent-color);
            border-radius: 2px;
            padding: 0 2px;
        }

        .se-card-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 5px;
            margin-top: 7px;
        }

        .se-tag-chip {
            background: rgba(255,255,255,0.06);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            padding: 2px 9px;
            font-size: 0.72rem;
            color: var(--text-muted);
            cursor: pointer;
            transition: all 0.15s;
            white-space: nowrap;
        }

        .se-tag-chip:hover,
        .se-tag-chip.active {
            background: rgba(59,130,246,0.15);
            border-color: var(--accent-color);
            color: var(--accent-color);
        }

        .se-card-col {
            font-size: 0.72rem;
            color: var(--text-muted);
            white-space: nowrap;
            flex-shrink: 0;
            margin-top: 2px;
            display: flex;
            align-items: center;
            gap: 4px;
        }


        .se-empty {
            text-align: center;
            padding: 60px 20px;
            color: var(--text-muted);
            display: none;
            flex-direction: column;
            align-items: center;
            gap: 12px;
        }

        .se-empty.visible { display: flex; }

        .se-empty-icon {
            width: 56px;
            height: 56px;
            background: rgba(255,255,255,0.04);
            border: 1px solid var(--border-color);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-muted);
        }

        .se-empty h3 { font-size: 1.1rem; font-weight: 600; color: var(--text-color); }
        .se-empty p  { font-size: 0.85rem; }

        .se-pagination {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            margin-top: 24px;
            flex-wrap: wrap;
        }

        .se-page-btn {
            min-width: 36px;
            height: 36px;
            border-radius: 8px;
            border: 1px solid var(--border-color);
            background: rgba(255,255,255,0.03);
            color: var(--text-muted);
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
            padding: 0 10px;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
        }

        .se-page-btn:hover:not(:disabled) {
            border-color: var(--accent-color);
            color: var(--accent-color);
        }

        .se-page-btn.active {
            background: var(--accent-color);
            border-color: var(--accent-color);
            color: white;
        }

        .se-page-btn:disabled {
            opacity: 0.3;
            cursor: not-allowed;
        }

        .se-sidebar {
            position: sticky;
            top: 80px;
            max-height: calc(100vh - 100px);
            display: flex;
            flex-direction: column;
        }

        .se-tags-panel {
            background: rgba(255,255,255,0.02);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 18px;
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 0;
        }

        .se-tags-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 14px;
            flex-shrink: 0;
        }

        .se-tags-header h3 {
            font-size: 0.85rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--text-muted);
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .se-tags-clear {
            background: none;
            border: none;
            font-size: 0.75rem;
            color: var(--text-muted);
            cursor: pointer;
            padding: 3px 8px;
            border-radius: 6px;
            transition: all 0.15s;
            display: none;
        }

        .se-tags-clear.visible { display: block; }
        .se-tags-clear:hover { color: #ef4444; background: rgba(239,68,68,0.08); }

        .se-tags-search-wrap {
            position: relative;
            margin-bottom: 12px;
            flex-shrink: 0;
        }

        .se-tags-search-icon {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            pointer-events: none;
        }

        #tagsFilter {
            width: 100%;
            background: rgba(255,255,255,0.04);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 7px 12px 7px 32px;
            font-size: 0.82rem;
            color: var(--text-color);
            outline: none;
            transition: all 0.2s;
        }

        #tagsFilter:focus {
            border-color: var(--accent-color);
            box-shadow: 0 0 0 2px var(--accent-glow);
        }

        [data-theme="light"] #tagsFilter { background: rgba(0,0,0,0.03); }

        .se-tags-scroll {
            overflow-y: auto;
            flex: 1;
            min-height: 0;
            padding-right: 2px;
        }

        .se-tags-scroll::-webkit-scrollbar { width: 3px; }
        .se-tags-scroll::-webkit-scrollbar-track { background: transparent; }
        .se-tags-scroll::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 4px; }
        .se-tags-scroll::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.2); }

        .se-tags-list {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .se-tag-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 7px 10px;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.15s;
            border: 1px solid transparent;
        }

        .se-tag-row:hover {
            background: rgba(255,255,255,0.04);
            border-color: var(--border-color);
        }

        .se-tag-row.active {
            background: rgba(59,130,246,0.12);
            border-color: rgba(59,130,246,0.3);
        }

        .se-tag-row-name {
            font-size: 0.82rem;
            font-weight: 500;
            color: var(--text-color);
            display: flex;
            align-items: center;
            gap: 6px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .se-tag-row.active .se-tag-row-name { color: var(--accent-color); }

        .se-tag-row-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--text-muted);
            flex-shrink: 0;
            transition: background 0.15s;
        }

        .se-tag-row.active .se-tag-row-dot { background: var(--accent-color); }

        .se-tag-count {
            font-size: 0.72rem;
            color: var(--text-muted);
            background: rgba(255,255,255,0.06);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 1px 7px;
            flex-shrink: 0;
        }

        .se-tag-row.active .se-tag-count {
            background: rgba(59,130,246,0.15);
            border-color: rgba(59,130,246,0.3);
            color: var(--accent-color);
        }

        .se-tags-more {
            font-size: 0.75rem;
            color: var(--text-muted);
            text-align: center;
            padding: 10px 0 4px;
            border-top: 1px solid var(--border-color);
            margin-top: 8px;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(8px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .se-divider {
            height: 1px;
            background: var(--border-color);
            margin: 4px 0 16px;
        }

        @media (max-width: 900px) {
            .se-wrapper {
                grid-template-columns: 1fr;
            }
            .se-sidebar {
                position: static;
                max-height: 320px;
            }
        }
    </style>
</head>

<body>

    <nav>
        <div class="nav-left">
            <a href="/home" style="display: flex; align-items: center; gap: 12px; text-decoration: none; color: inherit;">
                <img src="/assets/img/logo.png" alt="ClippedLinks Logo" class="logo">
                <span class="nav-title">ClippedLinks</span>
            </a>
        </div>

        <div class="nav-middle">
            <i data-lucide="search" class="search-icon"></i>
            <input type="text" class="search-input" id="navSearchProxy" placeholder="Search links..." autocomplete="off">
        </div>

        <div class="nav-right">
            <a href="/bookmark/<%= currentBookmark.id %><%= typeof isShared !== 'undefined' && isShared ? '?key=' + shareKey : '' %>" class="nav-icon-btn" title="Back to Board">
                <i data-lucide="layout-dashboard"></i>
            </a>
            <button id="themeToggle" class="theme-toggle" title="Toggle theme">
                <span id="themeIconContainer">
                    <i data-lucide="sun" id="themeIcon"></i>
                </span>
            </button>
            <div class="profile-container" id="profileContainer">
                <div class="profile-trigger" id="profileTrigger">
                    <img src="https://ui-avatars.com/api/?name=<%= username %>&background=3b82f6&color=fff" alt="Profile" class="profile-pic">
                </div>
                <div class="dropdown-menu" id="profileDropdown">
                    <a href="/settings" class="dropdown-item">
                        <i data-lucide="settings" style="width:16px;"></i> Settings
                    </a>
                    <div class="dropdown-divider"></div>
                    <a href="/logout" class="dropdown-item" style="color:#ef4444;">
                        <i data-lucide="log-out" style="width:16px;"></i> Logout
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <div class="se-wrapper fade-in">
        <div class="se-main">
            <div class="se-hero">
                <div class="se-breadcrumb">
                    <a href="<%= currentWorkspace ? '/workspace/' + currentWorkspace.id : '/home' %><%= typeof isShared !== 'undefined' && isShared ? '?key=' + shareKey : '' %>">
                        <%= currentWorkspace ? currentWorkspace.name : 'Home' %>
                    </a>
                    <i data-lucide="chevron-right" style="width:12px;height:12px; flex-shrink: 0;"></i>
                    <a href="/bookmark/<%= currentBookmark.id %><%= typeof isShared !== 'undefined' && isShared ? '?key=' + shareKey : '' %>"><%= currentBookmark.name %></a>
                    <i data-lucide="chevron-right" style="width:12px;height:12px; flex-shrink: 0;"></i>
                    <span>Search Engine</span>
                </div>

                <div class="se-title">
                    Search - <%= currentBookmark.name %>
                </div>
                <p class="se-subtitle">Find links by keyword, URL, description or tags.</p>

                <div class="se-input-wrap">
                    <i data-lucide="search" class="se-search-icon" style="width:18px;height:18px;"></i>
                    <input type="text" id="seInput" placeholder="Type anything to search…" autocomplete="off" spellcheck="false">
                    <button class="se-clear-btn" id="seClearBtn" type="button" aria-label="Clear search">
                        <i data-lucide="x" style="width:16px;height:16px;"></i>
                    </button>
                </div>

                <div class="se-stats">
                    <span id="seResultCount" class="se-stats-pill">0</span>
                    <span id="seResultLabel">results found</span>
                    <span id="seActiveTagLabel" style="display:none; color: var(--accent-color); font-weight: 600;"></span>
                </div>
            </div>

            <div class="se-divider"></div>

            <div id="seResults"></div>


            <div class="se-empty" id="seEmpty">
                <div class="se-empty-icon">
                    <i data-lucide="search-x" style="width:26px;height:26px;"></i>
                </div>
                <h3>No links found</h3>
                <p>Try a different search term or remove active tag filters.</p>
            </div>

            <div class="se-pagination" id="sePagination"></div>
        </div>

        <aside class="se-sidebar">
            <div class="se-tags-panel">
                <div class="se-tags-header">
                    <h3>
                        <i data-lucide="tag" style="width:13px;height:13px;"></i>
                        Tags
                    </h3>
                    <button class="se-tags-clear" id="tagsResetBtn" type="button">Clear</button>
                </div>

                <div class="se-tags-search-wrap">
                    <i data-lucide="search" class="se-tags-search-icon" style="width:13px;height:13px;"></i>
                    <input type="text" id="tagsFilter" placeholder="Filter tags…">
                </div>

                <div class="se-tags-scroll">
                    <div class="se-tags-list" id="tagsList"></div>
                    <div class="se-tags-more" id="tagsMoreLabel" style="display:none;"></div>
                </div>
            </div>
        </aside>
    </div>


    <div id="editLinkModal" class="modal-overlay">
        <div class="modal-container">
            <div class="modal-header">
                <h2>Edit Link</h2>
            </div>

            <form id="editLinkForm">
                <input type="hidden" id="editLinkId">
                <input type="hidden" id="editLinkColId">
                <div class="form-group" style="text-align: left; margin-bottom: 20px;">
                    <label for="editLinkName" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; color: var(--text-color); font-size: 0.9rem;">Name</label>
                    <input type="text" id="editLinkName" class="form-control" required style="width: 100%; padding: 12px 16px; border-radius: 8px; border: 1px solid var(--border-color); background: rgba(255, 255, 255, 0.03); color: var(--text-color); font-size: 0.95rem; box-sizing: border-box;">
                </div>
                <div class="form-group" style="text-align: left; margin-bottom: 20px;">
                    <label for="editLinkUrl" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; color: var(--text-color); font-size: 0.9rem;">URL</label>
                    <input type="url" id="editLinkUrl" class="form-control" required style="width: 100%; padding: 12px 16px; border-radius: 8px; border: 1px solid var(--border-color); background: rgba(255, 255, 255, 0.03); color: var(--text-color); font-size: 0.95rem; box-sizing: border-box;">
                </div>
                <div class="form-group" style="text-align: left; margin-bottom: 20px;">
                    <label for="editLinkDescription" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; color: var(--text-color); font-size: 0.9rem;">Description (Optional)</label>
                    <input type="text" id="editLinkDescription" class="form-control" style="width: 100%; padding: 12px 16px; border-radius: 8px; border: 1px solid var(--border-color); background: rgba(255, 255, 255, 0.03); color: var(--text-color); font-size: 0.95rem; box-sizing: border-box;">
                </div>
                <div class="form-group" style="text-align: left; margin-bottom: 20px;">
                    <label class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; color: var(--text-color); font-size: 0.9rem;">Tags (Optional, space or comma to confirm)</label>
                    <div class="tags-input-wrapper" id="editTagsWrapper" style="display: flex; flex-wrap: wrap; gap: 6px; background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-color); border-radius: 8px; padding: 6px 12px; min-height: 42px; align-items: center; cursor: text; box-sizing: border-box;">
                        <div id="editTagsContainer" style="display: flex; flex-wrap: wrap; gap: 6px;"></div>
                        <input type="text" id="editTagInput" style="background: transparent; border: none; color: var(--text-color); outline: none; flex: 1; min-width: 60px; font-size: 0.95rem;" placeholder="Add tags...">
                    </div>
                </div>

                <div class="modal-footer" style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 32px;">
                    <button type="button" id="closeEditLinkModal" style="padding: 10px 20px; border-radius: 8px; font-weight: 500; cursor: pointer; transition: all 0.2s; background: transparent; border: 1px solid var(--border-color); color: var(--text-color);">Cancel</button>
                    <button type="submit" style="padding: 10px 20px; border-radius: 8px; font-weight: 500; cursor: pointer; transition: all 0.2s; background: var(--accent-color); border: none; color: white;">Save Changes</button>
                </div>
            </form>
        </div>
    </div>


    <script src="/index.js"></script>
    <script>
        const bookmarkData = <%- JSON.stringify(currentBookmark) %>;

        console.log('[SearchEngine] Initializing with bookmark:', bookmarkData.name);
        console.log('[SearchEngine] Raw links data:', bookmarkData.links);

        const ALL_LINKS = [];
        const rawLinks = bookmarkData.links || [];

        if (Array.isArray(rawLinks)) {
            rawLinks.forEach((col, colIdx) => {
                if (!col) {
                    console.warn(`[SearchEngine] Column at index ${colIdx} is null/undefined`);
                    return;
                }
                const items = col.items || [];
                if (!Array.isArray(items)) {
                    console.warn(`[SearchEngine] Column "${col.name}" has non-array items:`, items);
                    return;
                }
                items.forEach(item => {
                    if (!item || !item.url) return;
                    ALL_LINKS.push({
                        ...item,
                        colName: col.name || 'Untitled'
                    });
                });
            });
        } else {
            console.error('[SearchEngine] bookmarkData.links is not an array. Type:', typeof rawLinks);
        }

        console.log('[SearchEngine] Total links flattened:', ALL_LINKS.length);

        ALL_LINKS.sort((a, b) => {
            const dateA = a.addedDate || 0;
            const dateB = b.addedDate || 0;
            return dateB - dateA;
        });

        const PER_PAGE = 13;
        let currentPage = 1;
        let currentQuery = '';
        let activeTag = null;

        const tagMap = {};
        ALL_LINKS.forEach(link => {
            (link.tags || []).forEach(t => {
                const tagStr = String(t);
                tagMap[tagStr] = (tagMap[tagStr] || 0) + 1;
            });
        });

        const sortedTags = Object.entries(tagMap).sort((a, b) => b[1] - a[1]);
        const TOP_TAGS = sortedTags.slice(0, 50);
        const EXTRA_TAGS = sortedTags.length > 50 ? sortedTags.length - 50 : 0;

        function getFaviconUrl(url) {
            try {
                const u = new URL(url.startsWith('http') ? url : 'https://' + url);
                return `/api/favicon?domain=${u.hostname}`;
            } catch {
                return null;
            }
        }

        function escapeHtml(str) {
            return String(str || '').replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
        }

        function highlight(str, q) {
            if (!q) return escapeHtml(str);
            const escaped = escapeHtml(str);
            const re = new RegExp(`(${q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
            return escaped.replace(re, '<mark>$1</mark>');
        }

        function filterLinks(q, tag) {
            const lq = q.toLowerCase().trim();
            return ALL_LINKS.filter(link => {
                const matchesTag = !tag || (link.tags || []).includes(tag);
                if (!matchesTag) return false;
                if (!lq) return true;
                return (
                    (link.name || '').toLowerCase().includes(lq) ||
                    (link.url || '').toLowerCase().includes(lq) ||
                    (link.description || '').toLowerCase().includes(lq) ||
                    (link.tags || []).some(t => t.toLowerCase().includes(lq))
                );
            });
        }

        function renderResults() {
          try {
            const results = filterLinks(currentQuery, activeTag);
            const total = results.length;
            const totalPages = Math.max(1, Math.ceil(total / PER_PAGE));
            if (currentPage > totalPages) currentPage = totalPages;

            const start = (currentPage - 1) * PER_PAGE;
            const pageItems = results.slice(start, start + PER_PAGE);

            const resultsEl = document.getElementById('seResults');
            const emptyEl   = document.getElementById('seEmpty');
            const countEl   = document.getElementById('seResultCount');
            const labelEl   = document.getElementById('seResultLabel');
            const tagLblEl  = document.getElementById('seActiveTagLabel');

            countEl.textContent = total;
            labelEl.textContent = total === 1 ? 'result found' : 'results found';

            if (activeTag) {
                tagLblEl.style.display = 'inline';
                tagLblEl.textContent   = `· filtered by #${activeTag}`;
            } else {
                tagLblEl.style.display = 'none';
            }

            if (total === 0) {
                resultsEl.innerHTML = '';
                emptyEl.classList.add('visible');
            } else {
                emptyEl.classList.remove('visible');
                const q = currentQuery;

                resultsEl.innerHTML = pageItems.map((link, idx) => {
                    try {
                        const rawUrl = link.url || '';
                        const href = rawUrl.startsWith('http') ? rawUrl : 'https://' + rawUrl;
                        let domain = '';
                        try { domain = new URL(href).hostname; } catch {}
                        const faviconUrl = getFaviconUrl(href);
                        const faviconHtml = faviconUrl
                            ? `<img src="${faviconUrl}" alt="" loading="lazy" onerror="this.parentElement.innerHTML='<i data-lucide=\\'link\\' style=\\'width:14px;height:14px;\\'></i>'">`
                            : `<i data-lucide="link" style="width:14px;height:14px;"></i>`;

                        const tags = (link.tags || []).filter(t => typeof t === 'string').slice(0, 5);
                        const tagsHtml = tags.length
                            ? `<div class="se-card-tags">${tags.map(t =>
                                `<span class="se-tag-chip${t === activeTag ? ' active' : ''}" data-tag="${escapeHtml(t)}">#${escapeHtml(t)}</span>`
                              ).join('')}</div>`
                            : '';

                        const descHtml = link.description && typeof link.description === 'string'
                            ? `<div class="se-card-desc">${highlight(link.description, q)}</div>`
                            : `<div class="se-card-desc async-desc" data-href="${escapeHtml(href)}"></div>`;

                        const editBtnHtml = (typeof isShared === 'undefined' || !isShared)
                            ? `<button class="se-edit-link-btn" data-id="${link.id}" data-col="${escapeHtml(link.colName)}" style="padding: 4px; border: none; background: transparent; color: var(--text-muted); cursor: pointer; transition: color 0.15s; margin-left: auto;">
                                  <i data-lucide="edit-2" style="width:13px;height:13px;"></i>
                               </button>`
                            : '';

                        return `
                            <a class="se-result-card" href="${escapeHtml(href)}" target="_blank" rel="noopener noreferrer"
                               style="animation-delay: ${idx * 30}ms;">
                                <div class="se-favicon">${faviconHtml}</div>
                                <div class="se-card-body">
                                    <div class="se-card-name">${highlight(link.name || rawUrl, q)}</div>
                                    ${domain ? `<div style="color: var(--text-muted); font-size: 0.8rem; font-weight: normal; margin-bottom: 5px;">${escapeHtml(domain)}</div>` : ''}

                                    ${descHtml}
                                    ${tagsHtml}
                                </div>
                                <div class="se-card-col" style="display: flex; flex-direction: column; align-items: flex-end; gap: 8px;">
                                    <div style="display: flex; align-items: center; gap: 4px;">
                                        <i data-lucide="columns" style="width:11px;height:11px;"></i>
                                        ${escapeHtml(link.colName)}
                                    </div>
                                    ${editBtnHtml}
                                </div>
                            </a>
                        `;
                    } catch (err) {
                        console.error('[SearchEngine] Error rendering link:', link, err);
                        return '';
                    }
                }).join('');

                resultsEl.querySelectorAll('.async-desc').forEach(el => {
                    const url = el.getAttribute('data-href');
                    if (url) {
                        fetch('/api/fetch-desc?url=' + encodeURIComponent(url))
                            .then(res => res.text())
                            .then(text => {
                                if (text) {
                                    el.innerHTML = highlight(text, q);
                                } else {
                                    el.style.display = 'none';
                                }
                            })
                            .catch(() => { el.style.display = 'none'; });
                    }
                });

                resultsEl.querySelectorAll('.se-tag-chip').forEach(chip => {
                    chip.addEventListener('click', e => {
                        e.preventDefault();
                        e.stopPropagation();
                        const t = chip.dataset.tag;
                        setActiveTag(t === activeTag ? null : t);
                    });
                });

                resultsEl.querySelectorAll('.se-edit-link-btn').forEach(btn => {
                    btn.addEventListener('click', e => {
                        e.preventDefault();
                        e.stopPropagation();
                        
                        const linkId = btn.dataset.id;
                        const linkColName = btn.dataset.col;
                        const link = ALL_LINKS.find(l => l.id === linkId);
                        
                        if (link) {
                            let trueColId = '';
                            if (bookmarkData.links) {
                                for (const col of bookmarkData.links) {
                                    if (col.items && col.items.some(i => i.id === linkId)) {
                                        trueColId = col.id;
                                        break;
                                    }
                                }
                            }

                            document.getElementById('editLinkId').value = link.id;
                            document.getElementById('editLinkColId').value = trueColId;
                            document.getElementById('editLinkName').value = link.name || '';
                            document.getElementById('editLinkUrl').value = link.url || '';
                            document.getElementById('editLinkDescription').value = link.description || '';
                            
                            editCurrentTags = [...(link.tags || [])];
                            renderEditTagsInput();
                            
                            document.getElementById('editLinkModal').classList.add('show');
                            document.getElementById('editLinkName').focus();
                        }
                    });
                });
            }

            renderPagination(totalPages);
            lucide.createIcons();
          } catch (err) {
            console.error('[SearchEngine] renderResults crashed:', err);
            document.getElementById('seResults').innerHTML =
                `<div style="padding:20px;color:#ef4444;font-size:0.85rem;">⚠ Render error — check browser console for details.</div>`;
          }
        }

        function renderPagination(totalPages) {
            const el = document.getElementById('sePagination');
            if (totalPages <= 1) { el.innerHTML = ''; return; }

            let html = '';
            html += `<button class="se-page-btn" id="pagePrev" ${currentPage === 1 ? 'disabled' : ''}>
                        <i data-lucide="chevron-left" style="width:14px;height:14px;"></i>
                    </button>`;

            const delta = 2;
            const left  = Math.max(1, currentPage - delta);
            const right = Math.min(totalPages, currentPage + delta);

            if (left > 1) {
                html += `<button class="se-page-btn" data-page="1">1</button>`;
                if (left > 2) html += `<button class="se-page-btn" disabled>…</button>`;
            }
            for (let p = left; p <= right; p++) {
                html += `<button class="se-page-btn${p === currentPage ? ' active' : ''}" data-page="${p}">${p}</button>`;
            }
            if (right < totalPages) {
                if (right < totalPages - 1) html += `<button class="se-page-btn" disabled>…</button>`;
                html += `<button class="se-page-btn" data-page="${totalPages}">${totalPages}</button>`;
            }

            html += `<button class="se-page-btn" id="pageNext" ${currentPage === totalPages ? 'disabled' : ''}>
                        <i data-lucide="chevron-right" style="width:14px;height:14px;"></i>
                    </button>`;

            el.innerHTML = html;

            el.querySelectorAll('[data-page]').forEach(btn => {
                btn.addEventListener('click', () => {
                    currentPage = parseInt(btn.dataset.page);
                    renderResults();
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                });
            });

            const prevBtn = document.getElementById('pagePrev');
            const nextBtn = document.getElementById('pageNext');
            if (prevBtn) prevBtn.addEventListener('click', () => { currentPage--; renderResults(); window.scrollTo({ top: 0, behavior: 'smooth' }); });
            if (nextBtn) nextBtn.addEventListener('click', () => { currentPage++; renderResults(); window.scrollTo({ top: 0, behavior: 'smooth' }); });

            lucide.createIcons();
        }

        function setActiveTag(tag) {
            activeTag = tag;
            currentPage = 1;
            renderTagList(document.getElementById('tagsFilter').value.trim().toLowerCase());
            renderResults();
            const clearBtn = document.getElementById('tagsResetBtn');
            if (activeTag) clearBtn.classList.add('visible');
            else clearBtn.classList.remove('visible');
        }

        function renderTagList(filterStr) {
            const listEl = document.getElementById('tagsList');
            const moreEl = document.getElementById('tagsMoreLabel');

            let tags = sortedTags;
            if (filterStr) {
                tags = tags.filter(([t]) => t.toLowerCase().includes(filterStr));
            }

            const shown = tags.slice(0, 50);
            const extra = tags.length > 50 ? tags.length - 50 : 0;

            listEl.innerHTML = shown.map(([tag, count]) => `
                <div class="se-tag-row${tag === activeTag ? ' active' : ''}" data-tag="${escapeHtml(tag)}">
                    <span class="se-tag-row-name">
                        <span class="se-tag-row-dot"></span>
                        ${escapeHtml(tag)}
                    </span>
                    <span class="se-tag-count">${count}</span>
                </div>
            `).join('');

            listEl.querySelectorAll('.se-tag-row').forEach(row => {
                row.addEventListener('click', () => {
                    const t = row.dataset.tag;
                    setActiveTag(t === activeTag ? null : t);
                });
            });

            if (extra > 0 && !filterStr) {
                moreEl.style.display = 'block';
                moreEl.textContent = `+${extra} more tags — scroll or filter to explore`;
            } else if (extra > 0 && filterStr) {
                moreEl.style.display = 'block';
                moreEl.textContent = `Showing top 50 matches`;
            } else {
                moreEl.style.display = 'none';
            }
        }

        const seInput   = document.getElementById('seInput');
        const clearBtn  = document.getElementById('seClearBtn');
        const navProxy  = document.getElementById('navSearchProxy');
        const tagsFilter = document.getElementById('tagsFilter');

        seInput.addEventListener('input', () => {
            currentQuery = seInput.value;
            navProxy.value = currentQuery;
            clearBtn.classList.toggle('visible', currentQuery.length > 0);
            currentPage = 1;
            renderResults();
        });

        navProxy.addEventListener('input', () => {
            currentQuery = navProxy.value;
            seInput.value = currentQuery;
            clearBtn.classList.toggle('visible', currentQuery.length > 0);
            currentPage = 1;
            renderResults();
        });

        clearBtn.addEventListener('click', () => {
            seInput.value = '';
            navProxy.value = '';
            currentQuery = '';
            clearBtn.classList.remove('visible');
            seInput.focus();
            currentPage = 1;
            renderResults();
        });

        tagsFilter.addEventListener('input', () => {
            renderTagList(tagsFilter.value.trim().toLowerCase());
        });

        document.getElementById('tagsResetBtn').addEventListener('click', () => {
            setActiveTag(null);
        });

        const profileTrigger  = document.getElementById('profileTrigger');
        const profileDropdown = document.getElementById('profileDropdown');
        profileTrigger.addEventListener('click', e => { e.stopPropagation(); profileDropdown.classList.toggle('show'); });
        document.addEventListener('click', () => profileDropdown.classList.remove('show'));
        profileDropdown.addEventListener('click', e => e.stopPropagation());

        const editLinkModal = document.getElementById('editLinkModal');
        let editCurrentTags = [];
        const editTagInput = document.getElementById('editTagInput');
        const editTagsContainer = document.getElementById('editTagsContainer');
        const editTagsWrapper = document.getElementById('editTagsWrapper');
        
        editTagsWrapper.addEventListener('click', () => editTagInput.focus());
        
        function renderEditTagsInput() {
            editTagsContainer.innerHTML = editCurrentTags.map((t, index) => `
                <span style="display: flex; align-items: center; gap: 4px; background: rgba(255,255,255,0.1); padding: 2px 8px; border-radius: 6px; font-size: 0.8rem; color: var(--text-muted);">
                    ${t}
                    <button type="button" onclick="removeEditTag(${index})" style="background: none; border: none; color: var(--text-muted); cursor: pointer; padding: 0; display: flex; align-items: center; margin-left: 2px;"><i data-lucide="x" style="width: 12px; height: 12px;"></i></button>
                </span>
            `).join('');
            lucide.createIcons();
        }
        
        window.removeEditTag = function(index) {
            editCurrentTags.splice(index, 1);
            renderEditTagsInput();
            editTagInput.focus();
        };

        editTagInput.addEventListener('keydown', (e) => {
            if (e.key === ' ' || e.key === ',' || e.key === 'Enter') {
                e.preventDefault();
                const val = editTagInput.value.trim().replace(/,/g, '');
                if (val && !editCurrentTags.includes(val)) {
                    editCurrentTags.push(val);
                    editTagInput.value = '';
                    renderEditTagsInput();
                } else {
                    editTagInput.value = '';
                }
            } else if (e.key === 'Backspace' && editTagInput.value === '' && editCurrentTags.length > 0) {
                editCurrentTags.pop();
                renderEditTagsInput();
            }
        });

        document.getElementById('closeEditLinkModal').addEventListener('click', () => {
            editLinkModal.classList.remove('show');
            document.getElementById('editLinkForm').reset();
        });

        editLinkModal.addEventListener('click', (e) => {
            if (e.target === editLinkModal) {
                editLinkModal.classList.remove('show');
                document.getElementById('editLinkForm').reset();
            }
        });

        document.getElementById('editLinkForm').addEventListener('submit', async (e) => {
            e.preventDefault();

            const linkId = document.getElementById('editLinkId').value;
            const colId = document.getElementById('editLinkColId').value;
            const name = document.getElementById('editLinkName').value;
            const url = document.getElementById('editLinkUrl').value;
            const description = document.getElementById('editLinkDescription').value;
            
            let val = document.getElementById('editTagInput').value.trim().replace(/,/g, '');
            if (val && !editCurrentTags.includes(val)) editCurrentTags.push(val);
            const tags = [...editCurrentTags];

            const link = ALL_LINKS.find(l => l.id === linkId);
            if (link) {
                link.name = name;
                link.url = url;
                link.description = description;
                link.tags = tags;
            }

            editLinkModal.classList.remove('show');
            e.target.reset();
            
            try {
                await fetch(`/api/link/update/<%= currentBookmark.id %>/${linkId}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name, url, description, tags })
                });
            } catch (err) {
                console.error('Link update failed:', err);
            }
            
            renderResults();
        });


        seInput.focus();

        renderTagList('');
        renderResults();
        lucide.createIcons();
    </script>
</body>

</html>
