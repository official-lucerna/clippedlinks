<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= currentWorkspace.name %> | ClippedLinks</title>
    <meta name="description"
        content="Save your favorite links elegantly without compromise. Open-Source premium bookmark manager for the modern web.">
    <link rel="icon" type="image/png" href="/assets/img/logo.png">
    
    <link rel="stylesheet" href="/assets/css/style.css">
    <script src="https://unpkg.com/lucide@latest"></script>
    
    <style>
        #contextMenu {
            position: fixed;
            z-index: 5000;
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 4px;
            backdrop-filter: blur(var(--glass-blur));
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
            display: none;
            flex-direction: column;
            min-width: 140px;
        }

        .context-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 12px;
            color: var(--text-color);
            text-decoration: none;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .context-item:hover {
            background: rgba(255,255,255,0.05);
            color: var(--accent-color);
        }

        .emoji-grid {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 8px;
            max-height: 300px;
            overflow-y: auto;
            padding: 8px;
        }

        .emoji-item {
            font-size: 1.5rem;
            padding: 8px;
            border-radius: 8px;
            cursor: pointer;
            text-align: center;
            transition: transform 0.2s;
        }

        .emoji-item:hover {
            background: rgba(255,255,255,0.1);
            transform: scale(1.2);
        }
    </style>
</head>
<body>


    <nav>
        <div class="nav-left">
            <a href="/home" style="display: flex; align-items: center; gap: 12px; text-decoration: none; color: inherit;">
                <img src="/assets/img/logo.png" alt="ClippedLinks Logo" class="logo">
                <span class="nav-title">ClippedLinks</span>
            </a>
        </div>
        
        <div class="nav-middle">
            <i data-lucide="search" class="search-icon"></i>
            <input type="text" class="search-input" placeholder="Search bookmarks...">
        </div>
        
        <div class="nav-right">
            <a href="https://github.com/firstdecree/clippedlinks" target="_blank" rel="noopener noreferrer" class="nav-icon-btn" title="GitHub">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
            </a>
            <button id="themeToggle" class="theme-toggle" title="Toggle theme">
                <span id="themeIconContainer">
                    <i data-lucide="sun" id="themeIcon"></i>
                </span>
            </button>
            
            <div class="profile-container" id="profileContainer">
                <div class="profile-trigger" id="profileTrigger">
                    <img src="https://ui-avatars.com/api/?name=<%= username %>&background=3b82f6&color=fff" alt="Profile" class="profile-pic">
                </div>
                <div class="dropdown-menu" id="profileDropdown">
                    <% if (typeof isShared === 'undefined' || !isShared) { %>
                    <a href="/settings" class="dropdown-item">
                        <i data-lucide="settings" style="width: 16px;"></i>
                        Settings
                    </a>
                    <div class="dropdown-divider"></div>
                    <a href="/logout" class="dropdown-item" style="color: #ef4444;">
                        <i data-lucide="log-out" style="width: 16px;"></i>
                        Logout
                    </a>
                    <% } else { %>
                    <a href="/login" class="dropdown-item">
                        <i data-lucide="log-in" style="width: 16px;"></i>
                        Login
                    </a>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>

    <div class="dashboard-wrapper">
        
        <aside class="sidebar">
            <div class="sidebar-section">
                <p class="sidebar-title">Menu</p>
                <a href="/home" class="sidebar-link">
                    <i data-lucide="bookmark"></i>
                    Bookmarks
                </a>
            </div>
            
            <div class="sidebar-section">
                <p class="sidebar-title">Workspaces</p>
                <% (workspaces || []).forEach(workspace => { %>
                <div class="workspace-item" data-id="<%= workspace.id %>" data-shared="<%= workspace.shared ? 'true' : 'false' %>" data-share-url="<%= workspace.shared ? `/workspace/${workspace.sharedId}?key=${workspace.sharedKey}` : '' %>" style="display: flex; align-items: center; justify-content: space-between; gap: 8px; border-radius: 12px; transition: background 0.2s;">
                    <div onclick="window.location.href='/workspace/<%= workspace.id %><%= typeof isShared !== 'undefined' && isShared ? '?key=' + shareKey : '' %>'" class="sidebar-link <%= (typeof currentWorkspace !== 'undefined' && currentWorkspace.id === workspace.id) ? 'active' : '' %>" style="flex: 1; padding-right: 8px; display: flex; align-items: center; gap: 8px; cursor: pointer;">
                        <% if (workspace.icon) { %>
                        <span class="workspace-emoji"><%= workspace.icon %></span>
                        <% } %>
                        <%= workspace.name %>
                    </div>
                    <% if (typeof isShared === 'undefined' || !isShared) { %>
                    <div class="delete-workspace-btn" data-id="<%= workspace.id %>" style="padding: 4px; border-radius: 6px; cursor: pointer; color: var(--text-muted); opacity: 0.5; transition: all 0.2s ease; display: flex; align-items: center;">
                        <i data-lucide="trash-2" style="width: 14px; height: 14px;"></i>
                    </div>
                    <% } %>
                </div>
                <% }) %>
                <% if (typeof isShared === 'undefined' || !isShared) { %>
                <a href="#" id="createWorkspaceTrigger" class="sidebar-link" style="color: var(--text-muted); font-style: italic; font-size: 0.85rem;">
                    <i data-lucide="plus-circle"></i>
                    Create New
                </a>
                <% } %>
            </div>
        </aside>


        <main class="main-content">
            <div class="fade-in">
                <header style="margin-bottom: 40px; display: flex; justify-content: space-between; align-items: center;">
                    <h1 style="font-size: 2rem; font-weight: 700;"><%= typeof currentWorkspace !== 'undefined' ? currentWorkspace.name : 'Workspace' %></h1>
                    <% if (typeof isShared === 'undefined' || !isShared) { %>
                    <button class="btn btn-primary" id="createBookmarkTrigger">
                        <i data-lucide="plus" style="margin-right: 8px;"></i>
                        Add Bookmark
                    </button>
                    <% } %>
                </header>

                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px;">
                    <% if ((bookmarks || []).length === 0) { %>
                    <div style="padding: 40px; border: 2px dashed var(--border-color); border-radius: 24px; text-align: center; color: var(--text-muted); grid-column: 1 / -1;">
                        <p>No bookmarks in this workspace yet. Start by adding one!</p>
                    </div>
                    <% } else { %>
                        <% (bookmarks || []).forEach(bookmark => { %>
                        <div class="form-card" data-id="<%= bookmark.id %>" data-workspace-id="<%= bookmark.workspaceId %>" data-shared="<%= bookmark.shared ? 'true' : 'false' %>" data-share-url="<%= bookmark.shared ? `/bookmark/${bookmark.sharedId}?key=${bookmark.sharedKey}` : '' %>" style="position: relative; padding: 24px; width: 100%; max-width: none; cursor: pointer; transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;" onmouseover="this.style.borderColor='var(--accent-color)'; this.style.transform='translateY(-4px)'" onmouseout="this.style.borderColor='var(--border-color)'; this.style.transform='translateY(0)'" onclick="const key = new URLSearchParams(window.location.search).get('key'); window.location.href='/bookmark/<%= bookmark.id %>' + (key ? '?key=' + key : '')">
                            <% if (typeof isShared === 'undefined' || !isShared) { %>
                            <button class="delete-bookmark-btn btn-outline" data-id="<%= bookmark.id %>" style="position: absolute; top: 16px; right: 16px; padding: 6px; border: none; background: transparent; color: var(--text-muted); border-radius: 8px; cursor: pointer; opacity: 0.5; transition: all 0.2s ease;">
                                <i data-lucide="trash-2" style="width: 16px; height: 16px;"></i>
                            </button>
                            <% } %>
                            <h3 style="font-size: 1.2rem; font-weight: 600; margin-bottom: 8px; padding-right: 32px;"><%= bookmark.name %></h3>
                            <p style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.5; margin-bottom: 16px;"><%= bookmark.description %></p>
                            <% const ws = (workspaces || []).find(w => w.id === bookmark.workspaceId); %>
                            <div style="display: inline-flex; align-items: center; gap: 6px; background: rgba(255,255,255,0.05); padding: 4px 10px; border-radius: 100px; font-size: 0.8rem; color: var(--text-muted);">
                                <i data-lucide="folder" style="width: 12px; height: 12px;"></i>
                                <%= ws ? ws.name : 'Unknown Workspace' %>
                            </div>
                        </div>
                        <% }) %>
                    <% } %>
                </div>
            </div>
        </main>
    </div>


    <div id="createBookmarkModal" class="modal-overlay">
        <div class="modal-container">
            <div class="modal-header">
                <h2>Add Bookmark</h2>
            </div>
            
            <form id="bookmarkForm">
                <% if ((workspaces || []).length === 0) { %>
                    <div class="error-message show" style="margin-bottom: 24px;">
                        <i data-lucide="alert-circle" style="width: 16px;"></i>
                        Please create a workspace first.
                    </div>
                <% } %>
                <div class="form-group">
                    <label for="bookmarkName" class="form-label">Name</label>
                    <input type="text" id="bookmarkName" name="name" class="form-control" placeholder="My Awesome Bookmark" required <% if ((workspaces || []).length === 0) { %>disabled<% } %>>
                </div>
                
                <div class="form-group">
                    <label for="bookmarkDesc" class="form-label">Description</label>
                    <textarea id="bookmarkDesc" name="description" class="form-control" placeholder="A short description..." rows="3" style="resize: none;" required <% if ((workspaces || []).length === 0) { %>disabled<% } %>></textarea>
                </div>
                
                <div class="form-group">
                    <label for="bookmarkWorkspace" class="form-label">Workspace</label>
                    <select id="bookmarkWorkspace" name="workspaceId" class="form-control" required <% if ((workspaces || []).length === 0) { %>disabled<% } %>>
                        <% (workspaces || []).forEach(ws => { %>
                            <option value="<%= ws.id %>" style="background: var(--card-bg); color: var(--text-color);" <%= (typeof currentWorkspace !== 'undefined' && currentWorkspace.id === ws.id) ? 'selected' : '' %> ><%= ws.name %></option>
                        <% }) %>
                    </select>
                </div>
                
                <div class="modal-footer">
                    <button type="button" id="closeBookmarkModal" class="btn btn-outline">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="submitBookmark" <% if ((workspaces || []).length === 0) { %>disabled<% } %>>Add</button>
                </div>
            </form>
        </div>
    </div>


    <div id="createWorkspaceModal" class="modal-overlay">
        <div class="modal-container">
            <div class="modal-header">
                <h2>Create Workspace</h2>
            </div>
            
            <form id="workspaceForm">
                <div class="form-group">
                    <label for="workspaceName" class="form-label">Name</label>
                    <input type="text" id="workspaceName" name="name" class="form-control" placeholder="Dashboard, Work, Personal..." required>
                </div>
                
                <div class="modal-footer">
                    <button type="button" id="closeModal" class="btn btn-outline">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="submitWorkspace">Create</button>
                </div>
            </form>
        </div>
    </div>


    <div id="contextMenu">
        <% if (typeof isShared === 'undefined' || !isShared) { %>
        <div class="context-item" id="addEmojiAction">
            <i data-lucide="smile" style="width: 16px;"></i>
            Add Emoji
        </div>
        <div class="context-item" id="removeEmojiAction" style="color: #ef4444;">
            <i data-lucide="smile" style="width: 16px; opacity: 0.7;"></i>
            Remove Emoji
        </div>
        <div class="context-item" id="shareAction">
            <i data-lucide="share" style="width: 16px;"></i>
            Share
        </div>
        <div class="context-item" id="copyShareAction" style="display: none;">
            <i data-lucide="copy" style="width: 16px;"></i>
            Copy Share
        </div>
        <div class="context-item" id="unshareAction" style="color: #ef4444; display: none;">
            <i data-lucide="share-2" style="width: 16px;"></i>
            Unshare
        </div>
        <% } %>
    </div>


    <div id="emojiPickerModal" class="modal-overlay">
        <div class="modal-container" style="max-width: 350px;">
            <div class="modal-header">
                <h2>Choose Emoji</h2>
            </div>
            
            <div class="emoji-grid" id="emojiGrid">
            </div>
            
            <div class="modal-footer">
                <button type="button" id="closeEmojiModal" class="btn btn-outline">Cancel</button>
            </div>
        </div>
    </div>


    <script src="/index.js"></script>
    <script>

        const profileTrigger = document.getElementById('profileTrigger');
        const profileDropdown = document.getElementById('profileDropdown');

        profileTrigger.addEventListener('click', (e) => {
            e.stopPropagation();
            profileDropdown.classList.toggle('show');
        });

        document.addEventListener('click', () => {
            profileDropdown.classList.remove('show');
        });

        profileDropdown.addEventListener('click', (e) => {
            e.stopPropagation();
        });

        lucide.createIcons();

        <% if (typeof isShared === 'undefined' || !isShared) { %>
        const modal = document.getElementById('createWorkspaceModal');
        const trigger = document.getElementById('createWorkspaceTrigger');
        const closeBtn = document.getElementById('closeModal');
        const form = document.getElementById('workspaceForm');

        if (trigger) {
            trigger.addEventListener('click', (e) => {
                e.preventDefault();
                modal.classList.add('show');
                document.getElementById('workspaceName').focus();
            });
        }

        const hideModal = () => {
            if(modal) modal.classList.remove('show');
            if(form) form.reset();
        };

        if (closeBtn) closeBtn.addEventListener('click', hideModal);

        if (modal) {
            modal.addEventListener('click', (e) => {
                if (e.target === modal) hideModal();
            });
        }

        if (form) {
            form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const name = document.getElementById('workspaceName').value;
            
            const btn = document.getElementById('submitWorkspace');
            btn.textContent = 'Creating...';
            btn.disabled = true;

            try {
                const response = await fetch('/api/workspace/create', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name })
                });

                if (response.ok) {
                    location.reload(); 
                } else {
                    alert('Failed to create workspace. Please try again.');
                    btn.textContent = 'Create';
                    btn.disabled = false;
                }
            } catch (err) {
                console.error(err);
                btn.textContent = 'Create';
                btn.disabled = false;
            }
        });
        }


        document.querySelectorAll('.delete-workspace-btn').forEach(btn => {
            btn.addEventListener('mouseenter', () => { 
                btn.style.opacity = '1'; 
                btn.style.color = '#ef4444'; 
            });
            btn.addEventListener('mouseleave', () => { 
                btn.style.opacity = '0.5'; 
                btn.style.color = 'var(--text-muted)'; 
            });

            btn.addEventListener('click', async (e) => {
                e.preventDefault();
                e.stopPropagation();
                
                if(!confirm('Are you sure you want to delete this workspace? This action cannot be undone.')) return;
                
                const workspaceId = btn.getAttribute('data-id');
                btn.disabled = true;
                
                try {
                    const response = await fetch(`/api/workspace/delete/${workspaceId}`, {
                        method: 'POST'
                    });

                    if (response.ok) {
                        location.href = '/home'; 
                    } else {
                        alert('Failed to delete workspace.');
                        btn.disabled = false;
                    }
                } catch (err) {
                    console.error(err);
                    alert('An error occurred.');
                    btn.disabled = false;
                }
            });
        });


        const bModal = document.getElementById('createBookmarkModal');
        const bTrigger = document.getElementById('createBookmarkTrigger');
        const bCloseBtn = document.getElementById('closeBookmarkModal');
        const bForm = document.getElementById('bookmarkForm');

        if (bTrigger) {
            bTrigger.addEventListener('click', (e) => {
                e.preventDefault();
                bModal.classList.add('show');
                const bName = document.getElementById('bookmarkName');
                if(bName && !bName.disabled) bName.focus();
            });
        }

        const hideBModal = () => {
            if (bModal) bModal.classList.remove('show');
            if (bForm) bForm.reset();
        };

        if (bCloseBtn) bCloseBtn.addEventListener('click', hideBModal);

        if (bModal) {
            bModal.addEventListener('click', (e) => {
                if (e.target === bModal) hideBModal();
            });
        }

        if (bForm) {
            bForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const name = document.getElementById('bookmarkName').value;
            const description = document.getElementById('bookmarkDesc').value;
            const workspaceId = document.getElementById('bookmarkWorkspace').value;
            
            const btn = document.getElementById('submitBookmark');
            const orig = btn.textContent;
            btn.textContent = 'Adding...';
            btn.disabled = true;

            try {
                const response = await fetch('/api/bookmark/create', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name, description, workspaceId })
                });

                if (response.ok) {
                    location.reload(); 
                } else {
                    alert('Failed to add bookmark. Please try again.');
                    btn.textContent = orig;
                    btn.disabled = false;
                }
            } catch (err) {
                console.error(err);
                btn.textContent = orig;
                btn.disabled = false;
            }
        });
        }


        document.querySelectorAll('.delete-bookmark-btn').forEach(btn => {
            btn.addEventListener('click', async (e) => {
                e.preventDefault();
                e.stopPropagation();
                if(!confirm('Delete this bookmark?')) return;
                const id = btn.getAttribute('data-id');
                try {
                    const res = await fetch(`/api/bookmark/delete/${id}`, { method: 'POST' });
                    if(res.ok) location.reload();
                } catch(err) { console.error(err); }
            });
        });
        <% } %>


        const contextMenu = document.getElementById('contextMenu');
        const emojiModal = document.getElementById('emojiPickerModal');
        let selectedWorkspaceId = null;
        let selectedBookmarkId = null;

        document.addEventListener('contextmenu', function(e) {
            <% if (typeof isShared !== 'undefined' && isShared) { %> return; <% } %>
            const workspaceItem = e.target.closest('.workspace-item');
            const bookmarkItem = e.target.closest('.form-card');
            
            if (workspaceItem || bookmarkItem) {
                e.preventDefault();
                e.stopPropagation();
                
                if (workspaceItem) {
                    selectedWorkspaceId = workspaceItem.getAttribute('data-id');
                    selectedBookmarkId = null;
                    const isShared = workspaceItem.getAttribute('data-shared') === 'true';
                    document.getElementById('addEmojiAction').style.display = 'flex';
                    document.getElementById('removeEmojiAction').style.display = 'flex';
                    if (isShared) {
                        document.getElementById('shareAction').style.display = 'none';
                        document.getElementById('copyShareAction').style.display = 'flex';
                        document.getElementById('unshareAction').style.display = 'flex';
                    } else {
                        document.getElementById('shareAction').style.display = 'flex';
                        document.getElementById('copyShareAction').style.display = 'none';
                        document.getElementById('unshareAction').style.display = 'none';
                    }
                } else {
                    selectedBookmarkId = bookmarkItem.getAttribute('data-id');
                    selectedWorkspaceId = null;
                    const isShared = bookmarkItem.getAttribute('data-shared') === 'true';
                    const parentWorkspaceId = bookmarkItem.getAttribute('data-workspace-id');
                    const parentWorkspaceEl = document.querySelector(`.workspace-item[data-id="${parentWorkspaceId}"]`);
                    const parentShared = parentWorkspaceEl ? parentWorkspaceEl.getAttribute('data-shared') === 'true' : false;
                    document.getElementById('addEmojiAction').style.display = 'none';
                    document.getElementById('removeEmojiAction').style.display = 'none';
                    if (parentShared) {
                        document.getElementById('shareAction').style.display = 'none';
                        document.getElementById('copyShareAction').style.display = 'none';
                        document.getElementById('unshareAction').style.display = 'none';
                    } else {
                        if (isShared) {
                            document.getElementById('shareAction').style.display = 'none';
                            document.getElementById('copyShareAction').style.display = 'flex';
                            document.getElementById('unshareAction').style.display = 'flex';
                        } else {
                            document.getElementById('shareAction').style.display = 'flex';
                            document.getElementById('copyShareAction').style.display = 'none';
                            document.getElementById('unshareAction').style.display = 'none';
                        }
                    }
                }
                
                contextMenu.style.display = 'flex';
                contextMenu.style.top = e.clientY + 'px';
                contextMenu.style.left = e.clientX + 'px';
            } else {
                contextMenu.style.display = 'none';
            }
        });

        document.addEventListener('click', function(e) {
            if (contextMenu && !contextMenu.contains(e.target)) {
                contextMenu.style.display = 'none';
            }
        });

        <% if (typeof isShared === 'undefined' || !isShared) { %>
        document.getElementById('shareAction').onclick = async () => {
            if (selectedWorkspaceId) {
                try {
                    const response = await fetch(`/api/workspace/share/${selectedWorkspaceId}`, { method: 'POST' });
                    if (response.ok) location.reload();
                } catch (err) { console.error(err); }
            } else if (selectedBookmarkId) {
                try {
                    const response = await fetch(`/api/bookmark/share/${selectedBookmarkId}`, { method: 'POST' });
                    if (response.ok) location.reload();
                } catch (err) { console.error(err); }
            }
        };

        document.getElementById('copyShareAction').onclick = () => {
            let el = null;
            if (selectedWorkspaceId) el = document.querySelector(`.workspace-item[data-id="${selectedWorkspaceId}"]`);
            else if (selectedBookmarkId) el = document.querySelector(`.form-card[data-id="${selectedBookmarkId}"]`);
            
            if (el) {
                const urlPath = el.getAttribute('data-share-url');
                if (urlPath) {
                    navigator.clipboard.writeText(window.location.origin + urlPath);
                    alert("Copied to clipboard!");
                }
            }
            contextMenu.style.display = 'none';
        };

        document.getElementById('unshareAction').onclick = async () => {
            if (selectedWorkspaceId) {
                try {
                    const response = await fetch(`/api/workspace/unshare/${selectedWorkspaceId}`, { method: 'POST' });
                    if (response.ok) location.reload();
                } catch (err) { console.error(err); }
            } else if (selectedBookmarkId) {
                try {
                    const response = await fetch(`/api/bookmark/unshare/${selectedBookmarkId}`, { method: 'POST' });
                    if (response.ok) location.reload();
                } catch (err) { console.error(err); }
            }
        };


        const emojis = ['📁', '💻', '📘', '🏡', '🎒', '📚', '🚀', '🔥', '✨', '⚡', '🤖', '👾', '🌈', '🎨', '🍕', '☕', '🌟', '🌙', '📅', '📝', '🔗', '💼', '💰', '📊', '🛠️', '🔒', '🔑', '🏷️', '📢', '💡'];
        const emojiGrid = document.getElementById('emojiGrid');
        
        emojis.forEach(emoji => {
            const el = document.createElement('div');
            el.className = 'emoji-item';
            el.textContent = emoji;
            el.onclick = async () => {
                if (!selectedWorkspaceId) return;
                try {
                    const response = await fetch(`/api/workspace/update/${selectedWorkspaceId}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ icon: emoji })
                    });
                    if (response.ok) location.reload();
                } catch (err) { console.error(err); }
                emojiModal.classList.remove('show');
            };
            emojiGrid.appendChild(el);
        });

        document.getElementById('addEmojiAction').onclick = () => {
            emojiModal.classList.add('show');
        };

        document.getElementById('removeEmojiAction').onclick = async () => {
            if (!selectedWorkspaceId) return;
            try {
                const response = await fetch(`/api/workspace/update/${selectedWorkspaceId}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ icon: null })
                });
                if (response.ok) location.reload();
            } catch (err) { console.error(err); }
        };

        document.getElementById('closeEmojiModal').onclick = () => {
            emojiModal.classList.remove('show');
        };

        emojiModal.addEventListener('click', (e) => {
            if(e.target === emojiModal) emojiModal.classList.remove('show');
        });
        <% } %>
    </script>
</body>
</html>
